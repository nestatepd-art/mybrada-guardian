Options -MultiViews
RewriteEngine On
RewriteBase /

RewriteRule ^index\.html$ - [L]

# Never turn missing files (images, scripts, styles) into the home page
RewriteRule \.(js|css|jpg|jpeg|png|gif|svg|webp|ico|woff2?|ttf|map)$ - [L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
